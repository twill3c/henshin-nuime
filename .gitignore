__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# 生成物 — data/raw から pipeline/ で作り直せる
data/editions/
data/sentences/
data/embeddings/

# 学習した重みと注意の点数表(約 66 MB)。`python -m pipeline.nmt` で作り直せる。
# **history.json だけは版に残す** —— 損失曲線と設定は成果物として小さく、
# 学習し直さずに「どの条件で出た数字か」を追えるようにするため。
data/nmt/*.npy
data/nmt/model.pt
data/nmt/vocab.json

# 事前学習モデル(約 1.06 GB)。入手手順は README に書く。
# **量子化版(118 MB)も版に入れない** —— 公開面はこれを Hugging Face から
# 直接落とす(N-03)。ここに置くのは局所で照合する(G-18)ためだけ。
models/*/model_quantized.onnx
models/*/model.onnx
models/*/model.safetensors
models/*/tokenizer.json

# 公開面
node_modules/
.next/
out/
.vercel/
tsconfig.tsbuildinfo

# 検品の産物(スクリーンショット)。`node scripts/inspect.mjs --shots` で作り直せる
artifacts/

# 焼いたデータ。`python -m pipeline.bake` で作り直せる。
# **版に残さない** —— 縫い目を焼き直すたびに 479 KB の差分が積み上がる。
public/data/
