__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# **公有でない原本は版に入れない**(HC-255)。
# 『審判』の英訳 PG #7849 は冒頭に COPYRIGHTED と明記され、著作権者の許諾で
# PG に収録されている作品である。版に入れれば再配布になる。
# 手元での計測(著作権法 30 条の 4)にだけ使い、入手手順は README に書く。
# 独 PG #69327 と青空 49863 は公有なので、他の原本と同じく版に残す。
data/raw/en_pg7849.txt

# 外挿検証の埋め込み(約 12 MB)。`python -m pipeline.extrapolate` で作り直せる
data/extrapolation/*.npy

# 生成物 — data/raw から pipeline/ で作り直せる
data/editions/
data/sentences/
data/embeddings/

# 学習した重みと注意の点数表(約 66 MB)。`python -m pipeline.nmt` で作り直せる。
# **history.json だけは版に残す** —— 損失曲線と設定は成果物として小さく、
# 学習し直さずに「どの条件で出た数字か」を追えるようにするため。
data/nmt/*.npy
data/nmt/model.pt
data/nmt/vocab.json

# 事前学習モデル(約 1.06 GB)。入手手順は README に書く。
# **量子化版(118 MB)も版に入れない** —— 公開面はこれを Hugging Face から
# 直接落とす(N-03)。ここに置くのは局所で照合する(G-18)ためだけ。
models/*/model_quantized.onnx
models/*/model.onnx
models/*/model.safetensors
models/*/tokenizer.json

# 公開面
node_modules/
.next/
out/
.vercel/
tsconfig.tsbuildinfo

# 検品の産物(スクリーンショット)。`node scripts/inspect.mjs --shots` で作り直せる
artifacts/

# 焼いたデータ。`python -m pipeline.bake` で作り直せる。
# **版に残さない** —— 縫い目を焼き直すたびに 479 KB の差分が積み上がる。
public/data/
